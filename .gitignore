# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Segredos
.env

# Cache do Extrator/Analista por modelo (regeravel por maquina/modelo, sem
# motivo pra sincronizar entre maquinas -- cada uma gera o proprio sozinha)
data/*/cache/

# Logs de execucao (resultados de verdade) SAO versionados de proposito: dois
# dos tres experimentos rodam em maquinas diferentes (Claude aqui, SLM local
# em outra), e e assim que os resultados se encontram -- git push de cada
# lado, git pull em quem for fazer a analise final.
*.log

# Saidas regeraveis da analise
analysis/tabela_resultados*.csv

.pytest_cache/

# macOS
.DS_Store

# LaTeX: artefatos de build (tudo regeravel a partir do .tex). O build do
# VS Code vai pra TCC_*/src/build/ (ver .vscode/settings.json), ja coberto
# por build/ acima; as regras abaixo cobrem builds feitos direto no terminal.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
missfont.log
TCC_*/src/*.pdf
