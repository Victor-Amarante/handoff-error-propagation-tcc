# Copie para .env e preencha.
#
# O projeto roda TRES experimentos, um por familia de modelo: GPT (OpenAI),
# Claude (Anthropic) e um SLM local (Ollama). Cada execucao usa UM provedor
# so -- troque HANDOFF_PROVIDER + HANDOFF_MODEL entre rodadas. Os artefatos
# (cache, logs) vao automaticamente para data/<slug-do-modelo>/, entao nao ha
# risco de misturar os tres. So preencha a chave de API do provedor que for
# usar na rodada.

# --------------------------------------------------------------------------
# Provedor ativo: openai | anthropic | ollama
# --------------------------------------------------------------------------
HANDOFF_PROVIDER=openai

# Temperatura. Deixe vazio para omitir o parametro da requisicao (gpt-5.6-luna
# REJEITA temperature=0, "only the default (1) is supported"). Vale para os
# tres provedores.
HANDOFF_TEMPERATURE=

# --------------------------------------------------------------------------
# Experimento 1 -- OpenAI (gpt-5.6-luna)
# --------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
HANDOFF_MODEL=gpt-5.6-luna

# Envia `seed` a API. 0 desliga (a seed continua identificando a replica no log).
HANDOFF_SEND_SEED=1

# Esforco de raciocinio: minimal | low | medium | high. Constante nas 4 condicoes.
# Mais esforco = mais chance de o proprio estagio corrigir o erro injetado, o que
# comprime as diferencas entre A/B/C/D; e reasoning tokens sao cobrados como output.
HANDOFF_REASONING_EFFORT=medium

# 1 = structured outputs nativo (Schema Validity ~1.0 por construcao)
# 0 = JSON mode sem gramatica restrita (Schema Validity vira medida nao-trivial)
HANDOFF_STRICT_OUTPUT=1

# --------------------------------------------------------------------------
# Experimento 2 -- Anthropic (Claude Haiku 4.5)
# --------------------------------------------------------------------------
# Para rodar: HANDOFF_PROVIDER=anthropic, preencha a chave abaixo, e troque
# HANDOFF_MODEL acima de verdade -- ou exporte diretamente:
#   HANDOFF_PROVIDER=anthropic HANDOFF_MODEL=claude-haiku-4-5-20251001 uv run ...
ANTHROPIC_API_KEY=

# Extended thinking do Claude. Vazio = desligado (constante com o espirito de
# "esforco moderado" do HANDOFF_REASONING_EFFORT=medium da OpenAI; Haiku 4.5 e
# vendido como o modelo RAPIDO da familia). Preencha com um budget em tokens
# (ex: 2000) soh se quiser medir o efeito de ligar o reasoning.
HANDOFF_CLAUDE_THINKING_BUDGET=
HANDOFF_CLAUDE_MAX_TOKENS=4096

# --------------------------------------------------------------------------
# Experimento 3 -- SLM local via Ollama (qwen3.5:9b-mlx)
# --------------------------------------------------------------------------
# Precisa do Ollama rodando localmente com o modelo puxado:
#   ollama pull qwen3.5:9b-mlx
# Para rodar: HANDOFF_PROVIDER=ollama HANDOFF_MODEL=qwen3.5:9b-mlx
OLLAMA_HOST=http://localhost:11434

# Qwen3 e hibrido (pensa ou nao, por chamada). 0 = desligado, mesmo motivo do
# Claude acima: mantem os tres experimentos comparaveis, sem introduzir um
# eixo de "esforco" que so o SLM teria.
HANDOFF_OLLAMA_THINK=0
